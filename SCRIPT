/* =====================================
DADOS
===================================== */

let clientes =
JSON.parse(
localStorage.getItem("lac_clientes")
) || [];

let produtos =
JSON.parse(
localStorage.getItem("lac_produtos")
) || [];

let carrinho =
JSON.parse(
localStorage.getItem("lac_carrinho")
) || [];

/* =====================================
NAVEGAÇÃO
===================================== */

const botoesMenu =
document.querySelectorAll(".menu-btn");

botoesMenu.forEach(botao => {

botao.addEventListener("click", () => {

abrirAba(botao.dataset.aba);


});

});

function abrirAba(nome) {

document
.querySelectorAll(".aba")
.forEach(aba => {

  aba.classList.remove("ativa");

});


const aba =
document.getElementById(nome);

if (aba) {

aba.classList.add("ativa");


}

botoesMenu.forEach(botao => {

botao.classList.remove("ativo");


if (
  botao.dataset.aba === nome
) {

  botao.classList.add("ativo");

}


});

if (nome === "vendas") {

atualizarVitrine();


}

}

/* =====================================
CLIENTES
===================================== */

const formCliente =
document.getElementById(
"formCliente"
);

formCliente.addEventListener(
"submit",
function(event) {

event.preventDefault();


const dados =
  new FormData(formCliente);


const cliente = {

  id: Date.now(),

  nome: dados.get("nome"),

  cpf: dados.get("cpf"),

  telefone: dados.get("telefone"),

  email: dados.get("email"),

  cep: dados.get("cep"),

  logradouro:
    dados.get("logradouro"),

  numero:
    dados.get("numero"),

  complemento:
    dados.get("complemento"),

  bairro:
    dados.get("bairro"),

  cidade:
    dados.get("cidade"),

  uf:
    dados.get("uf").toUpperCase()

};


clientes.push(cliente);


localStorage.setItem(
  "lac_clientes",
  JSON.stringify(clientes)
);


formCliente.reset();


document.getElementById(
  "avisoCliente"
).textContent =
  "Cliente cadastrado com sucesso!";


atualizarClientes();

atualizarResumo();


setTimeout(() => {

  document.getElementById(
    "avisoCliente"
  ).textContent = "";

}, 3000);


}
);

/* =====================================
LISTAR CLIENTES
===================================== */

function atualizarClientes() {

const corpo =
document.getElementById(
"corpoClientes"
);

corpo.innerHTML = "";

if (clientes.length === 0) {

corpo.innerHTML = `

  <tr>

    <td colspan="6">
      Nenhum cliente cadastrado.
    </td>

  </tr>

`;

return;


}

clientes.forEach(cliente => {

const tr =
  document.createElement("tr");


tr.innerHTML = `

  <td>
    ${cliente.id}
  </td>

  <td>
    ${cliente.nome}
  </td>

  <td>
    ${cliente.telefone || "-"}
  </td>

  <td>
    ${cliente.cidade}
  </td>

  <td>
    ${cliente.uf}
  </td>

  <td>

    <button
      class="btn-excluir"
      onclick="excluirCliente(${cliente.id})">

      Excluir

    </button>

  </td>

`;


corpo.appendChild(tr);


});

}

/* =====================================
EXCLUIR CLIENTE
===================================== */

function excluirCliente(id) {

if (
!confirm(
"Deseja excluir este cliente?"
)
) {

return;


}

clientes =
clientes.filter(
cliente =>
cliente.id !== id
);

localStorage.setItem(
"lac_clientes",
JSON.stringify(clientes)
);

atualizarClientes();

atualizarResumo();

}

/* =====================================
UPLOAD DE IMAGEM
===================================== */

const inputImagem =
document.getElementById(
"imagemProduto"
);

let imagemSelecionada = "";

inputImagem.addEventListener(
"change",
function() {

const arquivo =
  this.files[0];


if (!arquivo) {

  imagemSelecionada = "";

  return;

}


const leitor =
  new FileReader();


leitor.onload =
  function(event) {

    imagemSelecionada =
      event.target.result;


    document.getElementById(
      "previewImagem"
    ).innerHTML = `

      <img
        src="${imagemSelecionada}"
        alt="Prévia do produto">

    `;

  };


leitor.readAsDataURL(arquivo);


}
);

/* =====================================
PRODUTOS
===================================== */

const formProduto =
document.getElementById(
"formProduto"
);

formProduto.addEventListener(
"submit",
function(event) {

event.preventDefault();


const dados =
  new FormData(formProduto);


const produto = {

  id: Date.now(),

  nome:
    dados.get("produto"),

  codigo:
    dados.get("codigo"),

  categoria:
    dados.get("categoria"),

  preco:
    Number(
      dados.get("preco")
    ),

  estoque:
    Number(
      dados.get("estoque")
    ),

  descricao:
    dados.get("descricao"),

  imagem:
    imagemSelecionada

};


produtos.push(produto);


localStorage.setItem(
  "lac_produtos",
  JSON.stringify(produtos)
);


formProduto.reset();


document.getElementById(
  "previewImagem"
).innerHTML = "";


imagemSelecionada = "";


document.getElementById(
  "avisoProduto"
).textContent =
  "Produto cadastrado com sucesso!";


atualizarProdutos();

atualizarVitrine();

atualizarResumo();


setTimeout(() => {

  document.getElementById(
    "avisoProduto"
  ).textContent = "";

}, 3000);


}
);

/* =====================================
LISTAR PRODUTOS
===================================== */

function atualizarProdutos() {

const corpo =
document.getElementById(
"corpoProdutos"
);

corpo.innerHTML = "";

if (produtos.length === 0) {

corpo.innerHTML = `

  <tr>

    <td colspan="7">
      Nenhum produto cadastrado.
    </td>

  </tr>

`;

